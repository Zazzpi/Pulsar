# Для DEMO: python3 scripts/setup_demo.py создаст .env со случайными секретами.
APP_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_DB_ENGINE=postgresql
APP_DB_NAME=pulsar
APP_DB_USER=pulsar
APP_DB_PASSWORD=
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
WMS_MODE=mock
DEMO_USERNAME=demo
DEMO_PASSWORD=
# Эти значения требуются только для WMS_MODE=postgres на сервере.
WMS_DB_HOST=
WMS_DB_PORT=5432
WMS_DB_NAME=
WMS_DB_USER=
WMS_DB_PASSWORD=
WMS_DB_SSLMODE=require
SUMMARY_CACHE_TTL=60
STOCK_CACHE_TTL=60
ORDERS_CACHE_TTL=60
RECEIVING_CACHE_TTL=60
SHIPMENTS_CACHE_TTL=60
DEADLINE_WARNING_HOURS=24
INTEGRATION_STALE_HOURS=1
